# GeoLens language planner. The application always requests OpenRouter's
# zero-cost router and never falls back to a paid model.
OPENROUTER_API_KEY=

# The existing hosted environment may use this lower-case alias.
openrouter=

# Dedicated GeoLens model endpoints. Each endpoint receives the
# geolens-inference/v1 JSON contract and must return a valid GeoJSON geometry,
# an optional 0..1 confidence, confidenceCalibrated, detected, and a summary.
GEO_MODEL_FLOOD_URL=
GEO_MODEL_BURNSCAR_URL=
GEO_MODEL_VOLCANO_URL=
GEO_MODEL_OPEN_VOCAB_URL=
GEO_MODEL_VESSEL_URL=

# Optional shared bearer token for all specialist model endpoints.
GEO_MODEL_TOKEN=

# Required allowlist of exact service origins, comma separated. Endpoint URLs
# are rejected unless their origin appears here. HTTPS is required outside
# localhost/127.0.0.1 development.
GEO_MODEL_ALLOWED_ORIGINS=https://inference.example.com

# Bounded upstream behavior. Defaults are conservative and may be overridden.
GEO_MODEL_TIMEOUT_MS=25000
GEO_MODEL_MAX_ATTEMPTS=2
GEO_MODEL_RETRY_DELAY_MS=300
GEO_MODEL_MAX_RESPONSE_BYTES=2097152
GEO_MODEL_HEALTHCHECK_PATH=/ready
GEO_MODEL_HEALTH_TIMEOUT_MS=3000

# Backward-compatible generic endpoint. It is used only when a task-specific
# URL above is not set.
ANALYSIS_MODEL_URL=
ANALYSIS_MODEL_TOKEN=
