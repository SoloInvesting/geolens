# Validation-only backend. It never returns a positive or negative finding.
GEOLENS_BACKEND=mock

# Optional only for the validation-only mock. Every non-mock backend requires it.
GEOLENS_INFERENCE_TOKEN=

# Exact hosts or explicit *.example.com patterns. Do not use broad cloud wildcards.
GEOLENS_ASSET_HOSTS=planetarycomputer.microsoft.com,naipeuwest.blob.core.windows.net,catalogue.dataspace.copernicus.eu,download.dataspace.copernicus.eu,eodata.dataspace.copernicus.eu,zipper.dataspace.copernicus.eu,sentinel-cogs.s3.us-west-2.amazonaws.com,sentinel-cogs.s3.amazonaws.com,usgs-landsat.s3.us-west-2.amazonaws.com,landsatlook.usgs.gov,data.lpdaac.earthdatacloud.nasa.gov
GEOLENS_STAC_HOSTS=planetarycomputer.microsoft.com,stac.dataspace.copernicus.eu,earth-search.aws.element84.com,cmr.earthdata.nasa.gov

# Keep false unless a private object store is intentionally allowlisted.
GEOLENS_ALLOW_PRIVATE_HOSTS=false
GEOLENS_MAX_REQUEST_BYTES=1048576
GEOLENS_MAX_CONCURRENT_INFERENCES=1
GEOLENS_MAX_QUEUED_INFERENCES=4
GEOLENS_INFERENCE_QUEUE_TIMEOUT_SECONDS=30
GEOLENS_INFERENCE_TIMEOUT_SECONDS=300
GEOLENS_IDEMPOTENCY_TTL_SECONDS=300
GEOLENS_IDEMPOTENCY_MAX_ENTRIES=256

# Real open-vocabulary backend. Requires requirements-open-vocabulary.txt and a bearer token.
# GEOLENS_BACKEND=open-vocabulary
# GEOLENS_OPEN_VOCAB_DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
# GEOLENS_OPEN_VOCAB_SEGMENTER_MODEL=facebook/sam2.1-hiera-small
# GEOLENS_OPEN_VOCAB_MODEL_VERSION=grounding-dino-tiny+sam2.1-hiera-small/v1
# GEOLENS_OPEN_VOCAB_DEVICE=auto
# GEOLENS_OPEN_VOCAB_LOCAL_FILES_ONLY=false
# GEOLENS_OPEN_VOCAB_TILE_SIZE=768
# GEOLENS_OPEN_VOCAB_TILE_OVERLAP=96
# GEOLENS_OPEN_VOCAB_MAX_TILES=256
# GEOLENS_OPEN_VOCAB_MAX_DETECTIONS=500
# GEOLENS_OPEN_VOCAB_MAX_OBJECTS=8
# GEOLENS_OPEN_VOCAB_MAX_SCENES=2
# GEOLENS_OPEN_VOCAB_MAX_AOI_KM2=2500
# GEOLENS_ALLOW_REQUESTER_PAYS=false
